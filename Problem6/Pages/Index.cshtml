@page
@using Problem6.Pages
@model IndexModel

<!DOCTYPE html>
<html>
<head>
    <title>Student List</title>
</head>
<body>
    <div style="max-width: 900px; margin: 20px auto;">
        <h1>Student List</h1>
        <a href="/Create">Add New Student</a>

        @if (Model.Students.Count == 0)
        {
            <p>No students found. <a href="/Create">Add one</a></p>
        }
        else
        {
            <table border="1" style="margin-top: 20px; border-collapse: collapse;">
                <thead>
                    <tr>
                        <th style="padding: 10px;">ID</th>
                        <th style="padding: 10px;">First Name</th>
                        <th style="padding: 10px;">Last Name</th>
                        <th style="padding: 10px;">Email</th>
                        <th style="padding: 10px;">Roll Number</th>
                        <th style="padding: 10px;">Semester</th>
                        <th style="padding: 10px;">Department</th>
                        <th style="padding: 10px;">CGPA</th>
                        <th style="padding: 10px;">Enrollment Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model.Students)
                    {
                        <tr>
                            <td style="padding: 10px;">@student.Id</td>
                            <td style="padding: 10px;">@student.FirstName</td>
                            <td style="padding: 10px;">@student.LastName</td>
                            <td style="padding: 10px;">@student.Email</td>
                            <td style="padding: 10px;">@student.RollNumber</td>
                            <td style="padding: 10px;">@student.Semester</td>
                            <td style="padding: 10px;">@student.Department</td>
                            <td style="padding: 10px;">@student.CGPA</td>
                            <td style="padding: 10px;">@student.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</body>
</html>
