@page
@using Problem7.Pages
@model IndexModel

<!DOCTYPE html>
<html>
<head>
    <title>Teacher List</title>
</head>
<body>
    <div style="max-width: 900px; margin: 20px auto;">
        <h1>Teacher List</h1>
        <a href="/Create">Add New Teacher</a>

        @if (Model.Teachers.Count == 0)
        {
            <p>No teachers found. <a href="/Create">Add one</a></p>
        }
        else
        {
            <table border="1" style="margin-top: 20px; border-collapse: collapse;">
                <thead>
                    <tr>
                        <th style="padding: 10px;">ID</th>
                        <th style="padding: 10px;">First Name</th>
                        <th style="padding: 10px;">Last Name</th>
                        <th style="padding: 10px;">Email</th>
                        <th style="padding: 10px;">Subject</th>
                        <th style="padding: 10px;">Department</th>
                        <th style="padding: 10px;">Salary</th>
                        <th style="padding: 10px;">Join Date</th>
                        <th style="padding: 10px;">Phone</th>
                        <th style="padding: 10px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var teacher in Model.Teachers)
                    {
                        <tr>
                            <td style="padding: 10px;">@teacher.Id</td>
                            <td style="padding: 10px;">@teacher.FirstName</td>
                            <td style="padding: 10px;">@teacher.LastName</td>
                            <td style="padding: 10px;">@teacher.Email</td>
                            <td style="padding: 10px;">@teacher.Subject</td>
                            <td style="padding: 10px;">@teacher.Department</td>
                            <td style="padding: 10px;">$@teacher.Salary</td>
                            <td style="padding: 10px;">@teacher.JoinDate.ToString("yyyy-MM-dd")</td>
                            <td style="padding: 10px;">@teacher.PhoneNumber</td>
                            <td style="padding: 10px;">
                                <a href="/Edit?id=@teacher.Id">Edit</a> |
                                <a href="/Delete?id=@teacher.Id" onclick="return confirm('Delete?')">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</body>
</html>
